generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  nom        String
  motDePasse String
  emprunts      Emprunt[]
  consommations ConsommationIa[]
  creeLe     DateTime  @default(now())
}

model Ouvrage {
  id         Int       @id @default(autoincrement())
  titre      String    @db.VarChar(150)
  auteur     String
  disponible Boolean   @default(true)
  emprunts   Emprunt[]
}

model Emprunt {
  id            Int         @id @default(autoincrement())
  ouvrage       Ouvrage     @relation(fields: [ouvrageId], references: [id], onDelete: Restrict)
  ouvrageId     Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int
  empruntLe     DateTime    @default(now())
  retourPrevuLe DateTime
  rendu         Boolean     @default(false)

  @@index([utilisateurId, rendu])
}

model ConsommationIa {
  id            Int         @id @default(autoincrement())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int
  date          DateTime    @default(now())
  jetonsEntree  Int
  jetonsSortie  Int

  @@index([utilisateurId, date])
  @@map("consommation_ia")
}
